<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI LÀ TRIỆU PHÚ - V16</title>
  <style>
    :root {
      --bg1: #071a3d;
      --bg2: #0b2d62;
      --bg3: #1c5abf;
      --panel: rgba(8, 18, 40, 0.82);
      --panel-2: rgba(13, 28, 56, 0.88);
      --gold: #ffd54a;
      --blue: #1d3f82;
      --blue-2: #143669;
      --green: #19a85d;
      --red: #d73a3a;
      --white: #ffffff;
      --text: #dfe8ff;
      --stroke: rgba(255,255,255,0.12);
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      min-height: 100%;
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, var(--bg1), var(--bg2), var(--bg3));
      color: var(--white);
    }

    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .app {
      position: relative;
      width: min(1060px, 95vw);
      min-height: 720px;
      background: rgba(5, 13, 35, 0.85);
      border: 2px solid var(--stroke);
      border-radius: 22px;
      padding: 24px;
      box-shadow: 0 0 40px rgba(0,0,0,0.45);
      overflow: hidden;
    }

    .screen {
      display: none;
      position: relative;
      z-index: 2;
    }

    .screen.active {
      display: block;
      animation: fadeIn 0.25s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .title {
      text-align: center;
      font-size: clamp(2.3rem, 5vw, 4.2rem);
      font-weight: 900;
      color: var(--gold);
      letter-spacing: 2px;
      text-shadow: 0 0 18px rgba(255,213,74,0.6);
      margin-bottom: 12px;
    }

    .subtitle {
      text-align: center;
      color: var(--text);
      font-size: 1.15rem;
      line-height: 1.5;
      margin-bottom: 24px;
    }

    .main-buttons {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 16px;
    }

    button {
      border: none;
      border-radius: 12px;
      padding: 16px 24px;
      font-size: 1rem;
      font-weight: bold;
      cursor: pointer;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
      box-shadow: 0 8px 20px rgba(0,0,0,0.2);
      font-family: inherit;
    }

    button:hover { transform: translateY(-2px); }
    button:active { transform: translateY(0); }
    button:disabled { opacity: 0.5; cursor: not-allowed; transform: none !important; }

    .primary {
      background: linear-gradient(135deg, #ffb300, #ff8f00);
      color: #111;
      min-width: 180px;
    }

    .secondary {
      background: #dfe8ff;
      color: #14315f;
      min-width: 160px;
    }

    .ghost {
      background: rgba(255,255,255,0.08);
      color: #fff;
      border: 1px solid var(--stroke);
    }

    .menu-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(180px, 1fr));
      gap: 16px;
      max-width: 620px;
      margin: 0 auto;
    }

    .difficulty-btn {
      background: linear-gradient(180deg, #214c94, #183b75);
      color: var(--white);
      border: 1px solid rgba(255,255,255,0.15);
      min-height: 75px;
      font-size: 1.05rem;
    }

    .instruction-box {
      max-width: 700px;
      margin: 0 auto;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 14px;
      padding: 20px 22px;
      line-height: 1.8;
      color: #eef4ff;
    }

    .instruction-box ul {
      margin: 0;
      padding-left: 18px;
    }

    .game-layout {
      display: grid;
      grid-template-columns: 1.7fr 0.8fr;
      gap: 20px;
      min-height: 600px;
    }

    .board {
      background: var(--panel);
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.1);
      padding: 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .lifelines {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }

    .lifeline-btn {
      background: linear-gradient(135deg, #103769, #081d3f);
      color: var(--gold);
      border: 1px solid rgba(255,213,74,0.3);
      padding: 8px 14px;
      font-size: 0.9rem;
      border-radius: 20px;
      min-width: 110px;
    }

    .question-box {
      background: linear-gradient(180deg, #0a1f46, #103769);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 14px;
      padding: 22px 18px;
      min-height: 140px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-size: clamp(1.1rem, 1.8vw, 1.6rem);
      line-height: 1.5;
      margin-bottom: 14px;
      color: var(--white);
    }

    .answers {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .answer {
      background: linear-gradient(180deg, var(--blue), var(--blue-2));
      color: var(--white);
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 12px;
      padding: 14px;
      text-align: left;
      display: flex;
      align-items: center;
      min-height: 75px;
      font-size: 1rem;
      cursor: pointer;
    }

    .answer .label {
      width: 30px;
      height: 30px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: rgba(255,255,255,0.1);
      color: var(--gold);
      font-weight: bold;
      margin-right: 10px;
      flex-shrink: 0;
    }

    .answer.correct {
      background: linear-gradient(180deg, var(--green), #116f43);
      border-color: rgba(255,255,255,0.4);
    }

    .answer.wrong {
      background: linear-gradient(180deg, var(--red), #8b1d1d);
      border-color: rgba(255,255,255,0.4);
    }

    .answer.selected {
      outline: 3px solid #ffc857;
      box-shadow: 0 0 0 3px rgba(255,200,87,0.25);
    }

    .side-panel {
      background: var(--panel);
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.1);
      padding: 16px;
      display: flex;
      flex-direction: column;
      max-height: 600px;
    }

    .money-list {
      list-style: none;
      padding: 0;
      margin: 8px 0 0 0;
      display: flex;
      flex-direction: column;
      gap: 6px;
      overflow-y: auto;
      flex-grow: 1;
    }

    .money-list li {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 6px 10px;
      border-radius: 8px;
      background: rgba(255,255,255,0.04);
      border: 1px solid transparent;
      font-size: 0.9rem;
    }

    .money-list li.active {
      background: rgba(255,213,74,0.12);
      border-color: rgba(255,213,74,0.6);
      color: #ffe48d;
      font-weight: bold;
    }

    .money-list li.milestone {
      color: var(--gold);
    }

    .status-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      color: var(--text);
      font-size: 0.95rem;
      gap: 10px;
      flex-wrap: wrap;
    }

    .controls {
      display: flex;
      justify-content: space-between;
      margin-top: 14px;
      gap: 10px;
      flex-wrap: wrap;
    }

    .small-btn {
      min-width: 140px;
      padding: 10px 16px;
      font-size: 0.9rem;
    }

    .next-panel {
      display: none;
      margin-top: 14px;
      gap: 10px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .next-panel.visible {
      display: flex;
    }

    .timer {
      position: absolute;
      top: 16px;
      right: 16px;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.12);
      padding: 6px 12px;
      border-radius: 999px;
      font-weight: bold;
      color: var(--gold);
      min-width: 90px;
      text-align: center;
      z-index: 20;
    }

    .timer.warning { color: #ffb36b; border-color: rgba(255,179,107,0.6); }
    .timer.danger { color: #ff7a7a; border-color: rgba(255,122,122,0.6); }

    .modal {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.62);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 50;
    }

    .modal.active {
      display: flex;
    }

    .modal-card {
      width: min(480px, 92vw);
      background: linear-gradient(180deg, #152d5e, #0e2144);
      border-radius: 18px;
      padding: 24px;
      text-align: center;
      border: 1px solid rgba(255,255,255,0.15);
      box-shadow: 0 18px 40px rgba(0,0,0,0.35);
    }

    .modal-card h2 {
      margin-top: 0;
      margin-bottom: 12px;
      font-size: clamp(1.5rem, 2.5vw, 2.2rem);
    }

    .modal-card p {
      color: #dfe8ff;
      font-size: 1rem;
      line-height: 1.6;
      margin-bottom: 20px;
    }

    .modal-actions {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    @media (max-width: 780px) {
      .game-layout {
        grid-template-columns: 1fr;
      }
      .answers {
        grid-template-columns: 1fr;
      }
      .menu-grid {
        grid-template-columns: 1fr;
      }
      .timer {
        position: static;
        display: inline-block;
        margin: 0 auto 12px;
      }
    }
  </style>
</head>
<body>
  <div class="app">
    <div id="timer" class="timer">30s</div>

    <!-- Màn hình chính -->
    <section id="homeScreen" class="screen active">
      <div class="title">AI LÀ TRIỆU PHÚ</div>
      <div class="subtitle">Phiên bản nâng cấp V16 - Chinh phục giải thưởng đỉnh cao!</div>
      <div class="main-buttons">
        <button id="playBtn" class="primary">Chơi ngay</button>
        <button id="guideBtn" class="secondary">Hướng dẫn chơi</button>
        <button id="menuBtn" class="ghost">Chọn cấp độ</button>
      </div>
    </section>

    <!-- Màn hình Menu cấp độ -->
    <section id="menuScreen" class="screen">
      <div class="title">CHỌN CẤP ĐỘ</div>
      <div class="subtitle">Thử thách trí tuệ theo mức độ khó tăng dần</div>
      <div class="menu-grid">
        <button class="difficulty-btn" data-level="siêu dễ">Siêu dễ</button>
        <button class="difficulty-btn" data-level="dễ">Dễ</button>
        <button class="difficulty-btn" data-level="trung bình">Trung bình</button>
        <button class="difficulty-btn" data-level="khó">Khó</button>
        <button class="difficulty-btn" data-level="nâng cao">Nâng cao</button>
        <button class="difficulty-btn" data-level="custom" style="grid-column: span 2;">Thử thách tổng hợp</button>
      </div>
      <div class="main-buttons" style="margin-top: 20px;">
        <button id="backFromMenu" class="secondary">Quay lại</button>
      </div>
    </section>

    <!-- Màn hình Hướng dẫn -->
    <section id="guideScreen" class="screen">
      <div class="title">HƯỚNG DẪN CHƠI</div>
      <div class="instruction-box">
        <ul>
          <li>Mỗi câu hỏi có 30 giây để đưa ra đáp án chính xác.</li>
          <li>Bạn có 4 quyền trợ giúp hữu ích: <strong>50:50</strong>, <strong>Gọi điện</strong>, <strong>Hỏi khán giả</strong>, và <strong>Đổi câu hỏi</strong>.</li>
          <li>Trả lời sai hoặc hết thời gian, trò chơi sẽ kết thúc và nhận mức thưởng tương ứng mốc an toàn gần nhất.</li>
        </ul>
      </div>
      <div class="main-buttons" style="margin-top: 20px;">
        <button id="backFromGuide" class="secondary">Quay lại</button>
      </div>
    </section>

    <!-- Màn hình Trò chơi -->
    <section id="gameScreen" class="screen">
      <div class="status-bar">
        <div id="levelInfo">Màn 1</div>
        <div id="moneyInfo">0đ</div>
      </div>

      <div class="game-layout">
        <div class="board">
          <!-- Các quyền trợ giúp -->
          <div class="lifelines">
            <button id="lifeline50" class="lifeline-btn">50:50</button>
            <button id="lifelineCall" class="lifeline-btn">📞 Gọi điện</button>
            <button id="lifelineAud" class="lifeline-btn">👥 Khán giả</button>
            <button id="lifelineSwap" class="lifeline-btn">🔄 Đổi câu</button>
          </div>

          <div id="questionBox" class="question-box">Đang tải câu hỏi...</div>

          <div id="answers" class="answers"></div>

          <div class="controls">
            <button id="quitBtn" class="secondary small-btn">Dừng cuộc chơi</button>
            <button id="homeBtnGame" class="ghost small-btn">Về trang chủ</button>
          </div>

          <div id="nextPanel" class="next-panel">
            <button id="nextBtn" class="primary">Câu hỏi tiếp theo</button>
          </div>
        </div>

        <aside class="side-panel">
          <h3 style="margin:0; color:#ffd54a; text-align:center;">Thang tiền thưởng</h3>
          <ul id="moneyList" class="money-list"></ul>
        </aside>
      </div>
    </section>
  </div>

  <!-- Modal thông báo kết quả -->
  <div id="resultModal" class="modal">
    <div class="modal-card">
      <h2 id="resultTitle">Kết quả</h2>
      <p id="resultText"></p>
      <div class="modal-actions">
        <button id="primaryModalBtn" class="primary">Chơi lại</button>
        <button id="secondaryModalBtn" class="secondary">Về trang chủ</button>
      </div>
    </div>
  </div>

  <script>
    const levelOrder = ["siêu dễ", "dễ", "trung bình", "khó", "nâng cao", "custom"];

    const levels = {
      "siêu dễ": {
        rounds: 5,
        prizeBase: 200000,
        questions: [
          { q: "Tổng của 12 + 8 là?", a: ["18", "20", "22", "24"], c: 1 },
          { q: "Thủ đô của Việt Nam là?", a: ["Huế", "Hà Nội", "Đà Nẵng", "TP.HCM"], c: 1 },
          { q: "Động vật nào sống dưới nước?", a: ["Cá", "Mèo", "Gà", "Bò"], c: 0 },
          { q: "Một ngày có bao nhiêu giờ?", a: ["12", "18", "24", "36"], c: 2 },
          { q: "7 × 6 bằng mấy?", a: ["42", "40", "48", "36"], c: 0 }
        ]
      },
      "dễ": {
        rounds: 5,
        prizeBase: 500000,
        questions: [
          { q: "Từ nào là từ láy trong các từ sau?", a: ["Mẹ", "Lấp lánh", "Học", "Trẻ"], c: 1 },
          { q: "Số 9 là số nguyên tố hay hợp số?", a: ["Nguyên tố", "Hợp số", "Không rõ", "Số chẵn"], c: 1 },
          { q: "Trái Đất quay xung quanh thiên thể nào?", a: ["Mặt Trăng", "Mặt Trời", "Sao Hỏa", "Sao Kim"], c: 1 },
          { q: "Đại dương lớn nhất thế giới là?", a: ["Thái Bình Dương", "Ấn Độ Dương", "Đại Tây Dương", "Bắc Băng Dương"], c: 0 },
          { q: "3 × 4 = ?", a: ["7", "10", "12", "14"], c: 2 }
        ]
      },
      "trung bình": {
        rounds: 5,
        prizeBase: 1000000,
        questions: [
          { q: "Phương trình x + 5 = 9 có nghiệm x bằng:", a: ["3", "4", "5", "6"], c: 1 },
          { q: "'Truyện Kiều' của Nguyễn Du viết bằng thể thơ gì?", a: ["Lục bát", "Song thất lục bát", "Thơ tự do", "Đường luật"], c: 0 },
          { q: "Nước nào có diện tích lớn nhất thế giới?", a: ["Trung Quốc", "Mỹ", "Canada", "Nga"], c: 3 },
          { q: "Thành phố nào trực thuộc trung ương ở miền Trung?", a: ["Đà Nẵng", "Nha Trang", "Vũng Tàu", "Biên Hòa"], c: 0 },
          { q: "Hệ số góc của đường thẳng y = 2x + 1 là?", a: ["1", "2", "3", "0"], c: 1 }
        ]
      },
      "khó": {
        rounds: 5,
        prizeBase: 3000000,
        questions: [
          { q: "Phân tích đa thức x² - 9 thành nhân tử:", a: ["(x-3)(x+3)", "(x-9)(x+1)", "(x-1)(x+9)", "(x-3)²"], c: 0 },
          { q: "Khí nào chiếm tỉ lệ thể tích lớn nhất trong khí quyển Trái Đất?", a: ["Ôxy", "Nitơ", "Cacbonic", "Hidro"], c: 1 },
          { q: "Thủ đô của đất nước Indonesia hiện tại là?", a: ["Jakarta", "Bali", "Surabaya", "Bandung"], c: 0 },
          { q: "Giải phương trình x² - 5x + 6 = 0, tập nghiệm là:", a: ["{1; 4}", "{2; 3}", "{-2; -3}", "{0; 6}"], c: 1 },
          { q: "Nguyên tố hóa học nào có ký hiệu là 'Fe'?", a: ["Đồng", "Sắt", "Kẽm", "Nhôm"], c: 1 }
        ]
      },
      "nâng cao": {
        rounds: 5,
        prizeBase: 5000000,
        questions: [
          { q: "Giá trị của 2^5 là bao nhiêu?", a: ["10", "16", "32", "64"], c: 2 },
          { q: "Đại dương nào được mệnh danh là sâu nhất trên Trái Đất?", a: ["Thái Bình Dương", "Đại Tây Dương", "Ấn Độ Dương", "Biển Bắc"], c: 0 },
          { q: "Tác phẩm 'Tắt đèn' là sáng tác của nhà văn nào?", a: ["Nam Cao", "Ngô Tất Tố", "Vũ Trọng Phụng", "Thạch Lam"], c: 1 },
          { q: "Châu lục nào lạnh nhất trên Trái Đất?", a: ["Châu Âu", "Châu Mỹ", "Châu Nam Cực", "Châu Á"], c: 2 },
          { q: "Năm 1945 gắn liền với sự kiện lịch sử nào của Việt Nam?", a: ["Chiến thắng Điện Biên Phủ", "Cách mạng Tháng Tám", "Hiệp định Giơ-ne-vơ", "Giải phóng miền Nam"], c: 1 }
        ]
      },
      "custom": {
        rounds: 5,
        prizeBase: 2000000,
        questions: [
          { q: "3 + 3 × 3 bằng mấy?", a: ["18", "12", "9", "15"], c: 1 },
          { q: "Một con mèo có 4 chân, hỏi 2 con mèo có mấy chân?", a: ["4", "6", "8", "10"], c: 2 },
          { q: "Hành tinh nào trong hệ mặt trời được gọi là Hành tinh Đỏ?", a: ["Sao Thủy", "Sao Hỏa", "Sao Mộc", "Sao Thổ"], c: 1 },
          { q: "Loài chim nào không thể bay nhưng chạy rất nhanh?", a: ["Đà điểu", "Chim cánh cụt", "Gà tây", "Thiên nga"], c: 0 },
          { q: "Một năm không nhuận có bao nhiêu ngày?", a: ["364", "365", "366", "360"], c: 1 }
        ]
      }
    };

    const state = {
      currentLevelName: "siêu dễ",
      currentLevelIndex: 0,
      rounds: 0,
      earned: 0,
      usedQuestions: [],
      currentQuestion: null,
      answered: false,
      timeLeft: 30,
      timerId: null,
      lifelines: {
        fifty: false,
        call: false,
        audience: false,
        swap: false
      }
    };

    // DOM Elements
    const levelInfo = document.getElementById("levelInfo");
    const moneyInfo = document.getElementById("moneyInfo");
    const questionBox = document.getElementById("questionBox");
    const answersEl = document.getElementById("answers");
    const moneyList = document.getElementById("moneyList");
    const nextPanel = document.getElementById("nextPanel");
    const timerEl = document.getElementById("timer");
    const resultModal = document.getElementById("resultModal");
    const resultTitle = document.getElementById("resultTitle");
    const resultText = document.getElementById("resultText");
    const primaryModalBtn = document.getElementById("primaryModalBtn");
    const secondaryModalBtn = document.getElementById("secondaryModalBtn");

    // Lifeline buttons
    const btn50 = document.getElementById("lifeline50");
    const btnCall = document.getElementById("lifelineCall");
    const btnAud = document.getElementById("lifelineAud");
    const btnSwap = document.getElementById("lifelineSwap");

    let audioCtx = null;

    function getAudioCtx() {
      if (!audioCtx) {
        const Ctx = window.AudioContext || window.webkitAudioContext;
        if (!Ctx) return null;
        audioCtx = new Ctx();
      }
      if (audioCtx.state === "suspended") {
        audioCtx.resume();
      }
      return audioCtx;
    }

    function playTone(freq, duration, type = "sine", volume = 0.05, delay = 0) {
      const ctx = getAudioCtx();
      if (!ctx) return;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = type;
      osc.frequency.value = freq;
      gain.gain.value = volume;
      osc.connect(gain);
      gain.connect(ctx.destination);
      const t = ctx.currentTime + delay;
      osc.start(t);
      gain.gain.setValueAtTime(volume, t);
      gain.gain.exponentialRampToValueAtTime(0.0001, t + duration);
      osc.stop(t + duration);
    }

    function playCorrectSound() {
      [523.25, 659.25, 783.99, 1046.5].forEach((f, i) => playTone(f, 0.18, "triangle", 0.08, i * 0.1));
    }

    function playWrongSound() {
      [220, 174.61, 146.83].forEach((f, i) => playTone(f, 0.18, "sawtooth", 0.07, i * 0.12));
    }

    function playTapSound() {
      playTone(880, 0.05, "square", 0.03);
    }

    function showScreen(id) {
      document.querySelectorAll(".screen").forEach(s => s.classList.remove("active"));
      document.getElementById(id).classList.add("active");
    }

    function formatMoney(value) {
      return new Intl.NumberFormat("vi-VN", { style: "currency", currency: "VND" }).format(value);
    }

    function currentLevelData() {
      return levels[state.currentLevelName];
    }

    function getPrizeList() {
      const list = [];
      const data = currentLevelData();
      for (let i = 0; i < data.rounds; i++) {
        list.push(data.prizeBase * (i + 1));
      }
      return list;
    }

    function renderMoneyList() {
      const list = getPrizeList().slice().reverse();
      moneyList.innerHTML = "";
      list.forEach((money, index) => {
        const li = document.createElement("li");
        const levelNumber = list.length - index;
        if (levelNumber === state.rounds) {
          li.classList.add("active");
        }
        if (levelNumber === 5 || levelNumber === 10) {
          li.classList.add("milestone");
        }
        li.innerHTML = `<span>Màn ${levelNumber}</span><strong>${formatMoney(money)}</strong>`;
        moneyList.appendChild(li);
      });
    }

    function updateTimerUI() {
      timerEl.textContent = `${state.timeLeft}s`;
      timerEl.classList.remove("warning", "danger");
      if (state.timeLeft <= 10) {
        timerEl.classList.add("danger");
      } else if (state.timeLeft <= 20) {
        timerEl.classList.add("warning");
      }
    }

    function clearTimer() {
      if (state.timerId) {
        clearInterval(state.timerId);
        state.timerId = null;
      }
    }

    function startTimer() {
      clearTimer();
      state.timeLeft = 30;
      updateTimerUI();
      state.timerId = setInterval(() => {
        if (state.answered) return;
        state.timeLeft -= 1;
        updateTimerUI();
        if (state.timeLeft <= 0) {
          clearTimer();
          forceTimeout();
        }
      }, 1000);
    }

    function forceTimeout() {
      if (state.answered) return;
      state.answered = true;
      const buttons = [...answersEl.children];
      buttons.forEach(btn => btn.disabled = true);
      buttons.forEach((btn, i) => {
        if (parseInt(btn.dataset.index) === state.currentQuestion.c) {
          btn.classList.add("correct");
        }
      });
      playWrongSound();
      setTimeout(() => {
        openResult("HẾT GIỜ!", `Thời gian đã kết thúc. Số tiền bạn mang về: ${formatMoney(state.earned)}`, "fail");
      }, 900);
    }

    function pickQuestion() {
      const source = currentLevelData().questions;
      const available = source.filter(q => !state.usedQuestions.includes(q.q));
      if (available.length === 0) {
        state.usedQuestions = [];
        return source[Math.floor(Math.random() * source.length)];
      }
      return available[Math.floor(Math.random() * available.length)];
    }

    function renderQuestion() {
      state.currentQuestion = pickQuestion();
      state.usedQuestions.push(state.currentQuestion.q);
      state.answered = false;
      nextPanel.classList.remove("visible");

      state.rounds += 1;
      levelInfo.textContent = `Màn ${state.rounds}`;
      moneyInfo.textContent = formatMoney(state.earned);

      questionBox.textContent = state.currentQuestion.q;
      answersEl.innerHTML = "";

      state.currentQuestion.a.forEach((option, index) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "answer";
        btn.dataset.index = index;
        btn.innerHTML = `<span class="label">${String.fromCharCode(65 + index)}</span><span>${option}</span>`;
        btn.addEventListener("click", () => chooseAnswer(index));
        answersEl.appendChild(btn);
      });

      renderMoneyList();
      startTimer();
      playTapSound();
    }

    function chooseAnswer(index) {
      if (state.answered) return;
      clearTimer();
      state.answered = true;

      const buttons = [...answersEl.children];
      buttons.forEach(btn => {
        btn.disabled = true;
        const btnIdx = parseInt(btn.dataset.index);
        if (btnIdx === index) btn.classList.add("selected");
        if (btnIdx === state.currentQuestion.c) btn.classList.add("correct");
        if (btnIdx === index && btnIdx !== state.currentQuestion.c) btn.classList.add("wrong");
      });

      const totalRounds = currentLevelData().rounds;

      if (index === state.currentQuestion.c) {
        state.earned = currentLevelData().prizeBase * state.rounds;
        moneyInfo.textContent = formatMoney(state.earned);
        playCorrectSound();

        if (state.rounds >= totalRounds) {
          setTimeout(() => {
            openResult("CHIẾN THẮNG!", `Chúc mừng bạn đã chinh phục thành công màn ${state.currentLevelName.toUpperCase()} với giải thưởng ${formatMoney(state.earned)}.`, "success");
          }, 800);
        } else {
          setTimeout(() => {
            renderQuestion();
          }, 1200);
        }
      } else {
        playWrongSound();
        setTimeout(() => {
          openResult("TRẢ LỜI SAI!", `Rất tiếc, bạn đã trả lời sai. Số tiền bạn nhận được: ${formatMoney(state.earned)}`, "fail");
        }, 900);
      }
    }

    // Các quyền trợ giúp
    btn50.addEventListener("click", () => {
      if (state.lifelines.fifty || state.answered) return;
      state.lifelines.fifty = true;
      btn50.disabled = true;
      playTapSound();

      const buttons = [...answersEl.children];
      const correctIdx = state.currentQuestion.c;
      const incorrectBtns = buttons.filter(btn => parseInt(btn.dataset.index) !== correctIdx);
      
      // Ẩn 2 đáp án sai ngẫu nhiên
      incorrectBtns.sort(() => Math.random() - 0.5);
      for (let i = 0; i < 2; i++) {
        if (incorrectBtns[i]) {
          incorrectBtns[i].style.visibility = "hidden";
          incorrectBtns[i].disabled = true;
        }
      }
    });

    btnCall.addEventListener("click", () => {
      if (state.lifelines.call || state.answered) return;
      state.lifelines.call = true;
      btnCall.disabled = true;
      playTapSound();

      const correctLabel = String.fromCharCode(65 + state.currentQuestion.c);
      alert(`📞 Người thân tư vấn: "Tôi khá chắc chắn đáp án đúng là phương án ${correctLabel}!"`);
    });

    btnAud.addEventListener("click", () => {
      if (state.lifelines.audience || state.answered) return;
      state.lifelines.audience = true;
      btnAud.disabled = true;
      playTapSound();

      const correctLabel = String.fromCharCode(65 + state.currentQuestion.c);
      alert(`👥 Khảo sát ý kiến khán giả trong trường quay:\n- Phương án ${correctLabel}: 68%\n- Các phương án khác: 32%`);
    });

    btnSwap.addEventListener("click", () => {
      if (state.lifelines.swap || state.answered) return;
      state.lifelines.swap = true;
      btnSwap.disabled = true;
      playTapSound();
      state.rounds -= 1; // Giữ nguyên số thứ tự màn khi đổi câu
      renderQuestion();
    });

    function openResult(title, text, mode) {
      resultModal.classList.add("active");
      resultTitle.textContent = title;
      resultText.textContent = text;

      if (mode === "success") {
        primaryModalBtn.textContent = "Cấp độ tiếp theo";
        primaryModalBtn.onclick = () => {
          resultModal.classList.remove("active");
          goToNextLevel();
        };
      } else {
        primaryModalBtn.textContent = "Chơi lại";
        primaryModalBtn.onclick = () => {
          resultModal.classList.remove("active");
          startLevelByName(state.currentLevelName);
        };
      }

      secondaryModalBtn.onclick = () => {
        resultModal.classList.remove("active");
        goHome();
      };
    }

    function startLevelByName(levelName) {
      state.currentLevelName = levelName;
      state.currentLevelIndex = levelOrder.indexOf(levelName);
      state.usedQuestions = [];
      state.earned = 0;
      state.rounds = 0;
      state.answered = false;
      state.lifelines = { fifty: false, call: false, audience: false, swap: false };
      
      btn50.disabled = false;
      btnCall.disabled = false;
      btnAud.disabled = false;
      btnSwap.disabled = false;

      clearTimer();
      resultModal.classList.remove("active");
      showScreen("gameScreen");
      renderQuestion();
    }

    function goToNextLevel() {
      const nextIndex = state.currentLevelIndex + 1;
      const nextLevel = levelOrder[nextIndex] || levelOrder[0];
      startLevelByName(nextLevel);
    }

    function goHome() {
      clearTimer();
      showScreen("homeScreen");
      playTapSound();
    }

    // Event listeners chuyển màn hình
    document.getElementById("playBtn").addEventListener("click", () => startLevelByName("siêu dễ"));
    document.getElementById("guideBtn").addEventListener("click", () => { showScreen("guideScreen"); playTapSound(); });
    document.getElementById("menuBtn").addEventListener("click", () => { showScreen("menuScreen"); playTapSound(); });
    document.getElementById("backFromGuide").addEventListener("click", goHome);
    document.getElementById("backFromMenu").addEventListener("click", goHome);

    document.querySelectorAll(".difficulty-btn").forEach(btn => {
      btn.addEventListener("click", () => startLevelByName(btn.dataset.level));
    });

    document.getElementById("homeBtnGame").addEventListener("click", goHome);
    document.getElementById("quitBtn").addEventListener("click", () => {
      clearTimer();
      openResult("DỪNG CUỘC CHƠI", `Bạn đã quyết định dừng lại với số tiền thưởng: ${formatMoney(state.earned)}`, "success");
    });
  </script>
</body>
</html>
